# Environment Mode
NODE_ENV=development

# Database URL
# Local SQLite for immediate development & testing:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (use docker-compose or managed Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustvault?schema=public"

# Authentication & Session Security
SESSION_SECRET="trustvault-super-secure-production-random-secret-key-at-least-32-chars-long"
SESSION_MAX_AGE_SECONDS=86400
COOKIE_SECURE=false

# File Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT="./storage/vault_data"

# Optional S3 Configuration for Production
# STORAGE_DRIVER=s3
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_BUCKET="trustvault-confidential-documents"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Upload Security Policy
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_EXTENSIONS=".pdf,.docx,.xlsx,.png,.jpg,.jpeg"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
